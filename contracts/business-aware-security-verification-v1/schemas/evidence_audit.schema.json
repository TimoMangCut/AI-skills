{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_status",
    "audited_claims",
    "not_audited",
    "summary"
  ],
  "properties": {
    "audit_status": {
      "type": "string",
      "enum": [
        "complete",
        "partial"
      ]
    },
    "audited_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_ref",
          "verdict",
          "evidence_ids",
          "reason",
          "follow_up"
        ],
        "properties": {
          "claim_ref": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "supported",
              "partially_supported",
              "unsupported",
              "inconclusive"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          },
          "follow_up": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "not_audited": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    }
  }
}
