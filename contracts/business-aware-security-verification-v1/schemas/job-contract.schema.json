{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "phase_id",
    "phase_version",
    "run_id",
    "job_id",
    "skill",
    "skill_version",
    "scope_type",
    "repo_name",
    "objective",
    "input_artifact_refs",
    "context_summary",
    "related_invariant_refs",
    "related_task_refs",
    "allowed_tools",
    "allowed_read_paths",
    "read_scope",
    "output_schema",
    "evidence_policy",
    "budgets",
    "context_blinding",
    "must_not_conclude"
  ],
  "properties": {
    "phase_id": {
      "type": "string"
    },
    "phase_version": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "skill": {
      "type": "string"
    },
    "skill_version": {
      "type": "string"
    },
    "scope_type": {
      "type": "string",
      "enum": [
        "repository",
        "project",
        "targeted_repository"
      ]
    },
    "repo_name": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "input_artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context_summary": {
      "type": "string"
    },
    "related_invariant_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_task_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "list_dir",
          "read_file"
        ]
      }
    },
    "allowed_read_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "read_scope": {
      "type": "string",
      "enum": [
        "all_text",
        "source_config_docs",
        "none",
        "exact_paths"
      ]
    },
    "output_schema": {
      "type": "string"
    },
    "evidence_policy": {
      "type": "string"
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_model_turns",
        "max_tool_calls",
        "max_read_lines"
      ],
      "properties": {
        "max_model_turns": {
          "type": "integer"
        },
        "max_tool_calls": {
          "type": "integer"
        },
        "max_read_lines": {
          "type": "integer"
        }
      }
    },
    "context_blinding": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "must_not_conclude": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
