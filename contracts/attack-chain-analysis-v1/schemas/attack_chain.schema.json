                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "attacker_capability",
                  "identity_or_role",
                  "data_state",
                  "environment",
                  "timing",
                  "configuration",
                  "business_state",
                  "other"
