                    "relation": {
                      "type": "string",
                      "enum": [
                        "supports",
                        "contradicts",
                        "context",
                        "derived_from"
                      ]
                    },
                    "claim": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "evidence_id",
                    "relation",
                    "claim"
