    "analysis_id",
    "chain_id",
    "parent_chain_id",
    "related_chain_ids",
    "originating_finding_ids",
    "title",
    "attacker_objective",
    "business_invariant_at_risk",
    "scope",
    "attacker_model",
    "entry_point",
    "preconditions",
    "steps",
    "chain_verdict",
    "execution_status",
    "impact_assessment",
    "root_cause_ids",
    "counterevidence_refs",
    "unresolved_questions",
    "evidence_refs",
