{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localsec.local/schemas/attack-chain.schema.json",
  "title": "Attack Chain",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "analysis_id": {
      "type": "string",
      "minLength": 1
    },
    "chain_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_chain_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "related_chain_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "originating_finding_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "attacker_objective": {
      "type": "string",
      "minLength": 1
    },
    "business_invariant_at_risk": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repositories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authorized_environment": {
          "type": "string"
        },
        "target_profile_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "repositories",
        "services",
        "authorized_environment",
        "target_profile_id"
      ]
    },
    "attacker_model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initial_access": {
          "type": "string"
