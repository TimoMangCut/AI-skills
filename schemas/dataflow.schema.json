{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "flows",
    "trust_boundaries",
    "unknowns"
  ],
  "properties": {
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "destination",
          "protocol",
          "data_types",
          "trust_boundary",
          "controls",
          "status",
          "evidence_ids",
          "notes"
        ],
        "properties": {
          "direction": {
            "type": "string",
            "enum": [
              "inbound",
              "outbound",
              "internal",
              "bidirectional",
              "unknown"
            ]
          },
          "source": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "protocol": {
            "type": "string"
          },
          "data_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "trust_boundary": {
            "type": "string"
          },
          "identity_context": {
            "type": "string"
          },
          "controls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "observed",
              "derived",
              "hypothesis",
              "unknown",
              "not_assessed"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "trust_boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "evidence_ids",
          "notes"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "observed",
              "derived",
              "hypothesis",
              "unknown",
              "not_assessed"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
