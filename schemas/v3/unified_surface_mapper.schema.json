{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocalSec v3.0 Phase 1.4 Unified Surface Mapper Schema",
  "type": "object",
  "required": [
    "surface_checklist",
    "entrypoints",
    "semantic_clusters",
    "invariant_checks",
    "candidate_queue"
  ],
  "properties": {
    "repo_name": {
      "type": "string"
    },
    "surface_checklist": {
      "type": [
        "array",
        "object"
      ]
    },
    "entrypoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "method",
          "path",
          "file",
          "object_id_params",
          "ownership_check",
          "evidence_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "authn": {
            "type": "string"
          },
          "authz": {
            "type": "string"
          },
          "object_id_params": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ownership_check": {
            "type": "string",
            "enum": [
              "present",
              "missing",
              "partial",
              "not_applicable",
              "unknown"
            ]
          },
          "ownership_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "input_binding": {
            "type": "string",
            "enum": [
              "dto_whitelist",
              "raw_entity_or_map",
              "unvalidated_json",
              "none"
            ]
          },
          "response_shape": {
            "type": "string"
          },
          "rate_limit": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "semantic_clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cluster_id",
          "representative_endpoint",
          "representative_deep_read_evidence_ids",
          "member_endpoints",
          "outliers"
        ],
        "properties": {
          "cluster_id": {
            "type": "string",
            "minLength": 1
          },
          "shared_guard_signature": {
            "type": "string"
          },
          "shared_control_signature": {
            "type": "string"
          },
          "data_access_pattern": {
            "type": "string"
          },
          "representative_endpoint": {
            "type": "string"
          },
          "representative_file": {
            "type": "string"
          },
          "representative_deep_read_evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "member_files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "member_endpoints": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "object"
              ]
            }
          },
          "members": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "object"
              ]
            }
          },
          "member_count": {
            "type": "integer",
            "minimum": 0
          },
          "outliers": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "object"
              ]
            }
          }
        }
      }
    },
    "outliers": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "object"
        ]
      }
    },
    "invariant_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "invariant_id",
          "enforcement_status"
        ],
        "properties": {
          "invariant_id": {
            "type": "string",
            "minLength": 1
          },
          "enforcement_status": {
            "type": "string",
            "enum": [
              "enforced",
              "missing",
              "partial",
              "unknown"
            ]
          },
          "status": {
            "type": "string"
          },
          "intent_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "implementation_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "data_flows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "protocol": {
            "type": "string"
          },
          "identity_forwarding": {
            "type": "string",
            "enum": [
              "jwt_forwarded",
              "mtls_client_cert",
              "internal_header_signed",
              "internal_header_unsigned",
              "none",
              "unknown"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "sensitive_data": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "candidate_queue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "title",
          "target_paths",
          "attack_classes",
          "evidence_ids"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "target_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attack_classes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "severity": {
            "type": "string",
            "enum": [
              "negligible",
              "low",
              "medium",
              "high",
              "critical",
              "catastrophic"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    }
  }
}
