{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocalSec v3.0 Phase 1.2 Extractor Tailor Schema",
  "type": "object",
  "required": [
    "mode",
    "rationale",
    "canary_files",
    "canary_verified"
  ],
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "USE_STANDARD_EXTRACTOR",
        "USE_TAILORED_EXTRACTOR",
        "TAILOR_CUSTOM_EXTRACTOR",
        "SKIP_EXTRACTOR_DIRECT_READ"
      ]
    },
    "extractor_decision": {
      "type": "string",
      "enum": [
        "USE_STANDARD_EXTRACTOR",
        "USE_TAILORED_EXTRACTOR",
        "TAILOR_CUSTOM_EXTRACTOR",
        "SKIP_EXTRACTOR_DIRECT_READ"
      ]
    },
    "canary_verified": {
      "type": "boolean"
    },
    "rationale": {
      "type": "string",
      "minLength": 3
    },
    "canary_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expected_canary_hits": {
      "type": "integer",
      "minimum": 0
    },
    "actual_canary_hits": {
      "type": "integer",
      "minimum": 0
    },
    "extracted_hints_count": {
      "type": "integer",
      "minimum": 0
    },
    "script_path": {
      "type": "string"
    },
    "patterns_file": {
      "type": "string"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
