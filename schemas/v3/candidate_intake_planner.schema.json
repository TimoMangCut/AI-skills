{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocalSec v3.0 Phase 2.1 Candidate Intake Planner Schema",
  "type": "object",
  "required": [
    "selected_companions",
    "deduplicated_batches",
    "summary"
  ],
  "properties": {
    "repo_name": {
      "type": "string"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "selected_companions": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "object"
        ]
      }
    },
    "selected_companion_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excluded_companions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "module_id",
          "reason"
        ],
        "properties": {
          "module_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "deduplicated_batches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "batch_id",
          "candidate_ids",
          "rationale"
        ],
        "properties": {
          "batch_id": {
            "type": "string",
            "minLength": 1
          },
          "candidate_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "attack_classes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "target_repos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "priority_severity": {
            "type": "string",
            "enum": [
              "negligible",
              "low",
              "medium",
              "high",
              "critical",
              "catastrophic"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "batches": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "dismissed_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "reason",
          "evidence_ids"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 10
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          }
        }
      }
    },
    "summary": {
      "type": "string"
    }
  }
}
