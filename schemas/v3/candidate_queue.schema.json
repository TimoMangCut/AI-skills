{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocalSec v3.0 Phase 1 Candidate Queue Schema",
  "type": "object",
  "required": [
    "repo_name",
    "candidates"
  ],
  "properties": {
    "repo_name": {
      "type": "string",
      "minLength": 1
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "sources_summary": {
      "type": "object"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "title",
          "status",
          "evidence_ids"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "repo_name": {
            "type": "string"
          },
          "source_type": {
            "type": "string",
            "minLength": 1
          },
          "source_kind": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "target_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "target_path": {
            "type": "string"
          },
          "attack_classes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attack_class": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "negligible",
              "low",
              "medium",
              "high",
              "critical",
              "catastrophic"
            ]
          },
          "status": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_detail": {
            "type": "object"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "string"
    }
  }
}
