{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocalSec v3.0 Phase 2.3 Blinded Counterevidence Challenger Schema",
  "type": "object",
  "required": [
    "challenged_chains"
  ],
  "properties": {
    "repo_name": {
      "type": "string"
    },
    "challenged_chains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "chain_id",
          "challenge_verdict",
          "control_search_checklist",
          "counter_evidence_ids"
        ],
        "properties": {
          "chain_id": {
            "type": "string",
            "minLength": 1
          },
          "challenge_verdict": {
            "type": "string",
            "enum": [
              "confirmed_exploit_chain",
              "sustained",
              "upheld",
              "mitigated_by_existing_control",
              "refuted",
              "broken_link",
              "needs_runtime_verification",
              "partially_mitigated"
            ]
          },
          "control_search_checklist": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "status",
                "searched_paths"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "checked_found",
                    "checked_not_found",
                    "not_applicable"
                  ]
                },
                "searched_paths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "notes": {
                  "type": "string"
                }
              }
            }
          },
          "counter_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "empirical_refutations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "summary": {
      "type": "string"
    }
  }
}
