{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocalSec v3.0 Phase 2.2 Deep Trace Chain Analyst Schema",
  "type": "object",
  "required": [
    "chains",
    "unexploitable_candidates"
  ],
  "properties": {
    "repo_name": {
      "type": "string"
    },
    "chains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "chain_id",
          "candidate_ids",
          "chain_verdict",
          "hops",
          "root_cause",
          "request_plan",
          "evidence_ids"
        ],
        "properties": {
          "chain_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "candidate_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "chain_verdict": {
            "type": "string",
            "enum": [
              "confirmed",
              "code_supported",
              "partially_confirmed",
              "hypothesized",
              "refuted"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "negligible",
              "low",
              "medium",
              "high",
              "critical",
              "catastrophic"
            ]
          },
          "execution_status": {
            "type": "string"
          },
          "hops": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "hop_id",
                "hop_kind",
                "file",
                "evidence_ids"
              ],
              "properties": {
                "hop_id": {
                  "type": "string",
                  "minLength": 1
                },
                "hop_kind": {
                  "type": "string",
                  "enum": [
                    "in_process",
                    "http",
                    "grpc",
                    "message_queue",
                    "zmq_or_ipc",
                    "db",
                    "file_or_hardware"
                  ]
                },
                "repo_name": {
                  "type": "string"
                },
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "function_or_symbol": {
                  "type": "string"
                },
                "line_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "line_end": {
                  "type": "integer",
                  "minimum": 1
                },
                "notes": {
                  "type": "string"
                },
                "caller_evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "callee_evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "root_cause": {
            "type": [
              "object",
              "string"
            ]
          },
          "request_plan": {
            "type": "object",
            "properties": {
              "execution_status": {
                "type": "string",
                "enum": [
                  "not_executed",
                  "request_plan_only",
                  "executed",
                  "blocked",
                  "not_applicable"
                ]
              },
              "discriminating_requests": {
                "type": "array",
                "items": {
                  "type": [
                    "object",
                    "string"
                  ]
                }
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": [
                    "object",
                    "string"
                  ]
                }
              },
              "expected_safe_behavior": {
                "type": "string"
              },
              "expected_vulnerable_behavior": {
                "type": "string"
              }
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "remediation": {
            "type": "string"
          },
          "root_cause_cluster_id": {
            "type": "string"
          },
          "root_cause_hint_override_reason": {
            "type": "string"
          }
        }
      }
    },
    "unexploitable_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "reason",
          "evidence_ids"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 10
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          }
        }
      }
    },
    "root_causes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    }
  }
}
