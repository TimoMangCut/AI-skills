{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocalSec v3.0 Phase 1 Coverage Ledger Schema",
  "type": "object",
  "required": [
    "semantic_clusters"
  ],
  "properties": {
    "target_modules_total": {
      "type": "integer",
      "minimum": 0
    },
    "target_modules_visited": {
      "type": "integer",
      "minimum": 0
    },
    "unvisited_modules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "coverage_id",
          "status",
          "evidence_ids",
          "attempts"
        ],
        "properties": {
          "coverage_id": {
            "type": "string",
            "minLength": 7
          },
          "status": {
            "type": "string",
            "enum": [
              "covered_clean",
              "covered_finding",
              "reopened",
              "deferred_out_of_budget"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attempts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "semantic_clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cluster_id",
          "representative_deep_read_evidence_ids",
          "outliers"
        ],
        "properties": {
          "cluster_id": {
            "type": "string",
            "minLength": 1
          },
          "shared_control_signature": {
            "type": "string"
          },
          "shared_guard_signature": {
            "type": "string"
          },
          "data_access_pattern": {
            "type": "string"
          },
          "representative_endpoint": {
            "type": "string"
          },
          "representative_Format": {
            "type": "string"
          },
          "representative_deep_read_evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "member_endpoints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "member_count": {
            "type": "integer",
            "minimum": 1
          },
          "outliers": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "object"
              ]
            }
          }
        }
      }
    },
    "summary": {
      "type": "string"
    }
  }
}
