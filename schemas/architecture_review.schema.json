{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observations",
    "strengths",
    "unknowns"
  ],
  "properties": {
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "category",
          "assessment",
          "impact",
          "recommendation",
          "priority",
          "status",
          "evidence_ids",
          "notes"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "assessment": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "status": {
            "enum": [
              "observed",
              "derived",
              "hypothesis",
              "unknown",
              "not_assessed"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "status",
          "evidence_ids",
          "notes"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "status": {
            "enum": [
              "observed",
              "derived",
              "hypothesis",
              "unknown",
              "not_assessed"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
